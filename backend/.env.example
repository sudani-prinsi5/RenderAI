# =========================
# Database Configuration (MySQL / PostgreSQL / Cloud DB)
# =========================
# Option A: Single connection string (recommended on Render)
# DATABASE_URL=mysql+pymysql://user:password@host:port/dbname

# Option B: Individual parameters (for local MySQL)
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interior_designer

# =========================
# CORS / Frontend Configuration
# =========================
# Comma-separated list of additional allowed frontend origins
CORS_ORIGINS=https://render-ai-tau.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# =========================
# Email / Mail Configuration (Gmail SMTP)
# =========================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# =========================
# Flask Secret Key
# =========================
SECRET_KEY=your_flask_secret_key_here
